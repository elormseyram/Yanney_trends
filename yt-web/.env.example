# Supabase (same project as yt-admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: copy from yt-admin .env — needed for checkout + Paystack routes to write orders
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (secret stays server-side only)
PAYSTACK_SECRET_KEY=

# Optional: where the storefront sends "open admin" links
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
